# Caddy in front of the FastAPI backend and the built SPA. One origin serves
# both, so the browser never makes a cross-origin request and the API needs no
# CORS entry:
#
#   /api/*  → uvicorn on 127.0.0.1:8000 (bound to loopback, never public)
#   /*      → frontend/dist, with an index.html fallback
#
# The site address comes from SITE_ADDRESS. On a VM with no DNS name, sslip.io
# encodes the public IP (203.0.113.10 → 203-0-113-10.sslip.io) and Caddy still
# gets a real certificate. Left at localhost it serves plain HTTP only.
{
	# email you@example.com

	# Caddy's admin API is loopback-only by default, but it is unauthenticated:
	# any local process -- including the unprivileged API service -- could
	# rewrite this proxy's configuration. Nothing here uses `caddy reload`, so
	# turn the API off rather than leave a local reconfiguration path open.
	admin off

	# Bound how long a client may hold a connection while dribbling a request.
	# Caddy's defaults are generous, and a slow-loris style flood costs the box
	# connection slots and CPU even though it moves almost no bytes. There are
	# no uploads here, so a short body read is safe.
	#
	# Kept to the 2.6 directive set on purpose: Ubuntu ships 2.6.x, and the
	# `request_body` handler (a 1 MB cap) only exists from 2.7 onward. Adding it
	# here would fail the config on this host.
	servers {
		timeouts {
			# No header may take 10 s to arrive: a slowloris flood costs a
			# connection slot and a goroutine per socket, and this app has no
			# reason to wait on one.
			read_header 10s
			read_body 10s
			idle 60s
		}
	}
}

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# Security headers. Set here, once, so they cover the SPA, the API and the
	# 304s alike — a header block that only wrapped file_server would leave the
	# JSON responses (and anything the proxy decides) bare.
	#
	# The CSP is written against what the app actually loads: JS, CSS and the two
	# Rubik faces are same-origin (Vite bundles the first two, the fonts ship in
	# the repo), the batter headshot comes from img.mlbstatic.com with
	# crossOrigin="anonymous" so the canvas can read its pixels, and the debug
	# drawer saves a Blob. There is no inline script in index.html, so
	# script-src stays 'self'; 'unsafe-inline' is limited to styles because React
	# writes style attributes and there is no nonce to hand it.
	#
	# Two built-in dependencies of @react-three/drei and three.js are fetched at
	# runtime and have to be named or the scene dies on the first frame:
	#   www.gstatic.com    -- the DRACO decoder base URL
	#   cdn.jsdelivr.net   -- troika's unicode font resolver (non-latin glyphs)
	# drei's <Environment preset> used to be a third: it fetched its HDR from
	# raw.githack.com, which 302s to raw.githubusercontent.com, which this policy
	# blocked — the scene crashed on load. The HDR is now vendored under
	# public/env/ and served same-origin, so that host is gone from the policy.
	#
	# 'wasm-unsafe-eval' is not 'unsafe-eval': it permits WebAssembly
	# instantiation and nothing else, and the DRACO decoder is WASM.
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://img.mlbstatic.com; font-src 'self'; connect-src 'self' blob: https://www.gstatic.com https://cdn.jsdelivr.net; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Caddy advertises itself by default; this also drops the version, which
		# is the only part of that banner worth having from the outside.
		-Server
	}

	# Vite hashes everything under /assets; the entry point must revalidate.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# public/env holds the vendored HDR the scene fetches on its first frame.
	# The name is stable rather than content-hashed, so this is a bounded TTL,
	# not immutable: replacing the map means renaming it or lowering this.
	@vendored path /env/*
	header @vendored Cache-Control "public, max-age=2592000"
	# Caddy's MIME table has no entry for .hdr, and file_server omits the header
	# entirely rather than guessing — which `nosniff` makes worth fixing.
	header @vendored Content-Type "application/octet-stream"

	@entry path / /index.html
	header @entry Cache-Control "no-cache"

	# A cold trajectory build waits up to 15 s on statsapi, so the proxy's 30 s
	# default is closer to mattering than it looks.
	handle /api/* {
		# The wire protocol here is read-only: every route is a GET, and Caddy's
		# own TLS/ACME traffic never reaches this site block. Refusing anything
		# else costs one comparison and keeps request bodies, which no handler
		# reads, out of the proxy entirely: a POST flood is answered here rather
		# than streamed to uvicorn.
		#
		# This lives inside the handle block, not at site level, because Caddy
		# sorts `respond` after `handle` — a site-level copy would run only for
		# requests no handle matched, which is none of them. Within a handle the
		# order is respond, then reverse_proxy.
		@notread not method GET HEAD OPTIONS
		respond @notread 405

		reverse_proxy 127.0.0.1:8000 {
			# Overwrite rather than append: the API's per-client rate limit keys
			# on this header (the app only sees loopback), so a caller must not be
			# able to pick its own bucket by sending one.
			#
			# `caddy validate` reports this line as unnecessary because the proxy
			# sets the header on its own. Keep it: the default appends to whatever
			# the client sent, and replacing is what makes a forged value vanish
			# before the app ever sees it.
			header_up X-Forwarded-For {remote_host}
			transport http {
				read_timeout 60s
			}
		}
	}

	# No client-side router, but the fallback keeps a stale hashed chunk from
	# 404ing the page in the window after a new build ships.
	handle {
		# Same read-only rule for the static half (see the note above).
		@notread not method GET HEAD OPTIONS
		respond @notread 405

		root * /srv/mlb-live/frontend/dist
		try_files {path} /index.html
		file_server
	}
}
