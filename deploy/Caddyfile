# Caddy in front of the FastAPI backend and the built SPA. One origin serves
# both, so the browser never makes a cross-origin request and the API needs no
# CORS entry:
#
#   /api/*  → uvicorn on 127.0.0.1:8000 (bound to loopback, never public)
#   /*      → frontend/dist, with an index.html fallback
#
# The site address comes from SITE_ADDRESS. On a VM with no DNS name, sslip.io
# encodes the public IP (203.0.113.10 → 203-0-113-10.sslip.io) and Caddy still
# gets a real certificate. Left at localhost it serves plain HTTP only.
{
	# email you@example.com
}

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# Security headers. Set here, once, so they cover the SPA, the API and the
	# 304s alike — a header block that only wrapped file_server would leave the
	# JSON responses (and anything the proxy decides) bare.
	#
	# The CSP is written against what the app actually loads: JS, CSS and the two
	# Rubik faces are same-origin (Vite bundles the first two, the fonts ship in
	# the repo), the batter headshot is fetched from img.mlbstatic.com with
	# crossOrigin="anonymous" so the canvas can read its pixels, and the debug
	# drawer saves a Blob. There is no inline script in index.html, so
	# script-src stays 'self'; 'unsafe-inline' is limited to styles because React
	# writes style attributes and there is no nonce to hand it.
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://img.mlbstatic.com; font-src 'self'; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Caddy advertises itself by default; this also drops the version, which
		# is the only part of that banner worth having from the outside.
		-Server
	}

	# Vite hashes everything under /assets; the entry point must revalidate.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@entry path / /index.html
	header @entry Cache-Control "no-cache"

	# A cold trajectory build waits up to 15 s on statsapi, so the proxy's 30 s
	# default is closer to mattering than it looks.
	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			# Overwrite rather than append: the API's per-client rate limit keys
			# on this header (the app only sees loopback), so a caller must not be
			# able to pick its own bucket by sending one.
			header_up X-Forwarded-For {remote_host}
			transport http {
				read_timeout 60s
			}
		}
	}

	# No client-side router, but the fallback keeps a stale hashed chunk from
	# 404ing the page in the window after a new build ships.
	handle {
		root * /srv/mlb-live/frontend/dist
		try_files {path} /index.html
		file_server
	}
}
